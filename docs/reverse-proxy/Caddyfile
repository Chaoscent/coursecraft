# Caddy in front of Coursecraft on a LAN host without public DNS.
# App origin:     https://coursecraft.lan
# Content origin: https://coursecraft.lan:8443  (set COURSECRAFT_CONTENT_URL to this)
#
# .env:
#   COURSECRAFT_PUBLIC_URL=https://coursecraft.lan
#   COURSECRAFT_CONTENT_URL=https://coursecraft.lan:8443
#   COURSECRAFT_TRUST_PROXY=true
#
# `tls internal` makes Caddy issue certificates from its own local CA. Import
# that root certificate on every client once (see README in this folder).

{
	# Admin API reachable only from the host itself.
	admin localhost:2019
}

coursecraft.lan {
	tls internal
	reverse_proxy 127.0.0.1:3000
}

coursecraft.lan:8443 {
	tls internal
	# Content listener of the app container (COURSECRAFT_CONTENT_HTTP_PORT).
	reverse_proxy 127.0.0.1:3001
}
