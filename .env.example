# Lernwerk configuration. Copy to .env and adjust.
# Secrets (database passwords, master key) are generated on first start and
# never need to be set here.

# Public URL of the web app, as users reach it through your reverse proxy.
# Must be https, except http://localhost for local testing.
LERNWERK_PUBLIC_URL=http://localhost:3000

# Optional second origin for course playback (other host or other port).
# Required for importing third-party SCORM/xAPI/cmi5 packages.
# Examples: https://content.example.org  or  https://lernwerk.lan:8443
LERNWERK_CONTENT_URL=
# Port the content origin is published on (your reverse proxy forwards the
# content host or port to it).
LERNWERK_CONTENT_HTTP_PORT=3001

# Address and port the app is published on. Keep 127.0.0.1 behind a reverse
# proxy on the same host; use 0.0.0.0 only if the proxy runs elsewhere.
LERNWERK_BIND_ADDRESS=127.0.0.1
LERNWERK_HTTP_PORT=3000

# Set to true when running behind a reverse proxy that sets X-Forwarded-*.
LERNWERK_TRUST_PROXY=false

# Sessions: idle timeout (minutes) and absolute lifetime (hours).
LERNWERK_SESSION_IDLE_MINUTES=60
LERNWERK_SESSION_ABSOLUTE_HOURS=12

# Sign-in, setup and 2FA attempts per client address and minute.
LERNWERK_LOGIN_RATE_LIMIT=10

# fatal | error | warn | info | debug | trace
LERNWERK_LOG_LEVEL=info

# Converter (PPTX rendering, video): parallel jobs and CPU limit.
LERNWERK_CONVERTER_CONCURRENCY=1
LERNWERK_CONVERTER_CPUS=2
