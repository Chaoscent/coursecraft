# Coursecraft configuration. Copy to .env and adjust.
# Secrets (database passwords, master key) are generated on first start and
# never need to be set here.

# Public URL of the web app, as users reach it through your reverse proxy.
# Must be https, except http://localhost for local testing.
COURSECRAFT_PUBLIC_URL=http://localhost:3000

# Optional second origin for course playback (other host or other port).
# Required for importing third-party SCORM/xAPI/cmi5 packages.
# Examples: https://content.example.org  or  https://coursecraft.lan:8443
COURSECRAFT_CONTENT_URL=
# Port the content origin is published on (your reverse proxy forwards the
# content host or port to it).
COURSECRAFT_CONTENT_HTTP_PORT=3001

# Address and port the app is published on. Keep 127.0.0.1 behind a reverse
# proxy on the same host; use 0.0.0.0 only if the proxy runs elsewhere.
COURSECRAFT_BIND_ADDRESS=127.0.0.1
COURSECRAFT_HTTP_PORT=3000

# Set to true when running behind a reverse proxy that sets X-Forwarded-*.
COURSECRAFT_TRUST_PROXY=false

# Sessions: idle timeout (minutes) and absolute lifetime (hours).
COURSECRAFT_SESSION_IDLE_MINUTES=60
COURSECRAFT_SESSION_ABSOLUTE_HOURS=12

# Sign-in, setup and 2FA attempts per client address and minute.
COURSECRAFT_LOGIN_RATE_LIMIT=10

# Optional AI adapter (text revision, quiz drafts). Off by default: with
# false, no AI provider can be configured and the app makes no AI requests.
# Administrators set up providers in the app; every request is shown to the
# author and sent only after confirmation.
COURSECRAFT_AI_ENABLED=false
# Time zone for dates in e-mails (IANA name).
COURSECRAFT_TIME_ZONE=Europe/Berlin

# Seconds per AI request, and AI requests per user and minute.
COURSECRAFT_AI_TIMEOUT_SECONDS=90
COURSECRAFT_AI_RATE_LIMIT=10

# fatal | error | warn | info | debug | trace
COURSECRAFT_LOG_LEVEL=info

# Converter (PPTX rendering, video): parallel jobs and CPU limit.
COURSECRAFT_CONVERTER_CONCURRENCY=1
COURSECRAFT_CONVERTER_CPUS=2
