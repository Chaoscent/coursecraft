{
  "name": "coursecraft",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "dev": "pnpm -r --parallel --filter ./apps/* run dev",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p . && pnpm -r run typecheck",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "check:licenses": "tsx scripts/check-licenses.ts",
    "check:headers": "tsx scripts/check-spdx.ts",
    "check:terms": "tsx scripts/check-terms.ts",
    "check:urls": "tsx scripts/check-urls.ts",
    "check": "pnpm check:headers && pnpm check:terms && pnpm check:licenses && pnpm check:install-scripts",
    "check:install-scripts": "tsx scripts/check-install-scripts.ts",
    "test:e2e": "scripts/ci/playwright.sh"
  },
  "devDependencies": {
    "@coursecraft/eslint-config": "workspace:*",
    "@coursecraft/shared": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/smtp-server": "^3.5.13",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "eslint": "^10.12.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fastify": "^5.12.7",
    "globals": "^17.13.0",
    "jose": "^6.2.12",
    "jsdom": "^30.1.3",
    "kysely": "^0.29.6",
    "otplib": "^13.5.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "scorm-again": "^3.4.6",
    "smtp-server": "^3.19.23",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "xml-crypto": "^6.4.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  }
}
